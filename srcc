import re
from langchain_ollama import ChatOllama
from langchain.agents import create_agent   # older versions: from langgraph.prebuilt import create_react_agent
from src.agent.tools import policy_search, fee_calculator  # your Day 17 tools, as @tool functions

SYSTEM_PROMPT = """You are a bank policy assistant.
RULES:
1. ALWAYS call policy_search before answering any policy question. Never answer from memory.
2. Use fee_calculator only for fee/charge calculations, and only after policy_search.
3. Answer ONLY from tool results and cite sources (doc_id, section).
4. If the tools return nothing relevant, reply exactly: "Not found in policy docs."
5. Never request, store, or repeat personal data (account numbers, PAN/Aadhaar, phone, email).
6. If the question is not about bank policy, politely refuse."""

llm = ChatOllama(model="llama3.2:3b", temperature=0)

agent = create_agent(
    model=llm,
    tools=[policy_search, fee_calculator],
    system_prompt=SYSTEM_PROMPT,
)

# --- Guardrails (code-level, because a 3B model won't follow rules reliably) ---
PII_PATTERNS = [
    r"\b\d{9,18}\b",                          # account / card numbers
    r"\b\d{4}\s?\d{4}\s?\d{4}\b",             # Aadhaar-style
    r"\b[A-Z]{5}\d{4}[A-Z]\b",                # PAN
    r"[\w.+-]+@[\w-]+\.[\w.]+",               # email
]

def contains_pii(text: str) -> bool:
    return any(re.search(p, text) for p in PII_PATTERNS)

def ask_agent(question: str) -> dict:
    if contains_pii(question):
        return {"answer": "Please don't share personal data. I can only answer general bank policy questions.",
                "tools_used": []}

    result = agent.invoke({"messages": [("user", question)]})
    msgs = result["messages"]

    tools_used = [m.name for m in msgs if m.type == "tool"]

    # Enforce "always search before answer"
    if "policy_search" not in tools_used:
        forced = policy_search.invoke({"query": question})
        result = agent.invoke({"messages": [
            ("user", f"{question}\n\nPolicy search results:\n{forced}\nAnswer using only these.")
        ]})
        msgs = result["messages"]
        tools_used = ["policy_search (forced)"] + [m.name for m in msgs if m.type == "tool"]

    return {"answer": msgs[-1].content, "tools_used": tools_used}

from src.agent.agent import ask_agent

print("Bank Policy Agent (type 'exit' to quit)")
while True:
    q = input("\nYou: ").strip()
    if q.lower() in {"exit", "quit"}:
        break
    out = ask_agent(q)
    print(f"\nTools used: {out['tools_used']}")
    print(f"Agent: {out['answer']}")
