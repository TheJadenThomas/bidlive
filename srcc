import json
from pathlib import Path

SESSIONS_FILE = Path("data/sessions_demo.json")
MAX_TURNS = 5            # keep last N user/assistant pairs
MAX_HISTORY_CHARS = 4000 # rough budget (~1000 tokens) for history

class SessionStore:
    def __init__(self, path=SESSIONS_FILE):
        self.path = Path(path)
        self.sessions = {}
        if self.path.exists():
            try:
                self.sessions = json.loads(self.path.read_text(encoding="utf-8"))
            except json.JSONDecodeError:
                self.sessions = {}

    def add_turn(self, session_id, user_msg, assistant_msg):
        turns = self.sessions.setdefault(session_id, [])
        turns.append({"user": user_msg, "assistant": assistant_msg})
        self.sessions[session_id] = turns[-MAX_TURNS * 2:]  # hard cap stored turns
        self._save()

    def get_history(self, session_id):
        """Return recent turns as chat messages, trimmed to the char budget."""
        turns = self.sessions.get(session_id, [])[-MAX_TURNS:]
        # drop oldest turns until under budget
        while turns and sum(len(t["user"]) + len(t["assistant"]) for t in turns) > MAX_HISTORY_CHARS:
            turns = turns[1:]
        messages = []
        for t in turns:
            messages.append(("user", t["user"]))
            messages.append(("assistant", t["assistant"]))
        return messages

    def clear(self, session_id):
        self.sessions.pop(session_id, None)
        self._save()

    def _save(self):
        self.path.parent.mkdir(parents=True, exist_ok=True)
        self.path.write_text(json.dumps(self.sessions, indent=2), encoding="utf-8")




